# OKX API credentials
# Create at: https://www.okx.com/account/my-api
OKX_API_KEY=your_okx_api_key
OKX_API_SECRET=your_okx_api_secret
OKX_PASSPHRASE=your_okx_passphrase

# Binance API credentials
# Create at: https://www.binance.com/en/my/settings/api-management
# If you use Binance.US, add: BINANCE_TLD=us
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# Kraken API credentials
# Create at: https://www.kraken.com/u/security/api
KRAKEN_API_KEY=your_kraken_api_key
KRAKEN_API_SECRET=your_kraken_api_secret

# Robinhood credentials
# Uses username + password + MFA (no official API key)
ROBINHOOD_USERNAME=your_robinhood_email
ROBINHOOD_PASSWORD=your_robinhood_password
# Optional: TOTP key (base32) from your authenticator app setup
ROBINHOOD_TOTP_KEY=
